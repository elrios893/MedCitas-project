@{
    ViewData["Title"] = "Registrar Paciente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Dashboard">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="ListarUsuarios">Usuarios</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Registrar Paciente</li>
                </ol>
            </nav>

            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Paciente
                    </h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Error:</strong> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>Información:</strong> La cuenta del paciente se creará como verificada automáticamente.
                    </div>

                    <form asp-action="RegistrarPaciente" method="post">
                        <!-- Datos Personales -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-person-badge"></i> Datos Personales
                                </h5>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label for="nombreCompleto" class="form-label">
                                    Nombre Completo <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input type="text"
                                           name="nombreCompleto"
                                           id="nombreCompleto"
                                           class="form-control"
                                           placeholder="Ej: María García López"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="tipoDocumento" class="form-label">
                                    Tipo de Documento <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-card-heading"></i>
                                    </span>
                                    <select name="tipoDocumento"
                                            id="tipoDocumento"
                                            class="form-select"
                                            required>
                                        <option value="">Seleccione...</option>
                                        <option value="CC">Cédula de Ciudadanía</option>
                                        <option value="TI">Tarjeta de Identidad</option>
                                        <option value="CE">Cédula de Extranjería</option>
                                        <option value="PA">Pasaporte</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="numeroDocumento" class="form-label">
                                    Número de Documento <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-123"></i>
                                    </span>
                                    <input type="text"
                                           name="numeroDocumento"
                                           id="numeroDocumento"
                                           class="form-control"
                                           placeholder="1234567890"
                                           pattern="[0-9]+"
                                           maxlength="20"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="fechaNacimiento" class="form-label">
                                    Fecha de Nacimiento <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-calendar"></i>
                                    </span>
                                    <input type="date"
                                           name="fechaNacimiento"
                                           id="fechaNacimiento"
                                           class="form-control"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="sexo" class="form-label">
                                    Sexo <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-gender-ambiguous"></i>
                                    </span>
                                    <select name="sexo"
                                            id="sexo"
                                            class="form-select"
                                            required>
                                        <option value="">Seleccione...</option>
                                        <option value="M">Masculino</option>
                                        <option value="F">Femenino</option>
                                        <option value="O">Otro</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Datos de Contacto -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-telephone"></i> Datos de Contacto
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="telefono" class="form-label">
                                    Teléfono <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-telephone-fill"></i>
                                    </span>
                                    <input type="text"
                                           name="telefono"
                                           id="telefono"
                                           class="form-control"
                                           placeholder="3012345678"
                                           pattern="[0-9]{7,15}"
                                           maxlength="15"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="correoElectronico" class="form-label">
                                    Correo Electrónico <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>
                                    <input type="email"
                                           name="correoElectronico"
                                           id="correoElectronico"
                                           class="form-control"
                                           placeholder="paciente@example.com"
                                           required />
                                </div>
                            </div>
                        </div>

                        <!-- Información Médica -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-heart-pulse"></i> Información Médica
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="eps" class="form-label">
                                    EPS <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-hospital"></i>
                                    </span>
                                    <select name="eps"
                                            id="eps"
                                            class="form-select"
                                            required>
                                        <option value="">Seleccione...</option>
                                        <option value="Compensar">Compensar</option>
                                        <option value="Sanitas">Sanitas</option>
                                        <option value="Sura">Sura</option>
                                        <option value="Nueva EPS">Nueva EPS</option>
                                        <option value="Salud Total">Salud Total</option>
                                        <option value="Famisanar">Famisanar</option>
                                        <option value="Otra">Otra</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="tipoSangre" class="form-label">
                                    Tipo de Sangre <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-droplet-fill"></i>
                                    </span>
                                    <select name="tipoSangre"
                                            id="tipoSangre"
                                            class="form-select"
                                            required>
                                        <option value="">Seleccione...</option>
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Seguridad -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-shield-lock"></i> Seguridad
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label">
                                    Contraseña <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input type="password"
                                           name="password"
                                           id="password"
                                           class="form-control"
                                           placeholder="Mínimo 8 caracteres"
                                           required />
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="togglePassword">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <small class="form-text text-muted">
                                    Debe contener: mayúsculas, minúsculas, números y símbolos
                                </small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="confirmarPassword" class="form-label">
                                    Confirmar Contraseña <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <input type="password"
                                           name="confirmarPassword"
                                           id="confirmarPassword"
                                           class="form-control"
                                           placeholder="Repita la contraseña"
                                           required />
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            id="toggleConfirmPassword">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-person-plus-fill"></i> Registrar Paciente
                            </button>
                            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver al dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/password-toggle.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-forms.css" />
}