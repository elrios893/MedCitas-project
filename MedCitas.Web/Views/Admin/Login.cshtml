@{
    ViewData["Title"] = "Acceso de Administrador";
}

<style>
    body {
        background: radial-gradient(circle at top left, #0f2027, #203a43, #2c5364);
        font-family: 'JetBrains Mono', monospace;
        color: #e0e0e0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .admin-login-card {
        background: rgba(15, 15, 20, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        backdrop-filter: blur(10px);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
        width: 100%;
        max-width: 420px;
        padding: 2rem;
        transition: all 0.3s ease-in-out;
    }

        .admin-login-card:hover {
            box-shadow: 0 0 30px rgba(0, 200, 255, 0.2);
            transform: translateY(-2px);
        }

        .admin-login-card h2 {
            color: #00bcd4;
            font-weight: 600;
            font-size: 1.6rem;
        }

    .form-control {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
    }

        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: #00bcd4;
            box-shadow: 0 0 0 0.2rem rgba(0, 188, 212, 0.25);
        }

    label {
        color: #b0bec5;
        font-size: 0.9rem;
    }

    .btn-primary {
        background: linear-gradient(90deg, #00bcd4, #2196f3);
        border: none;
        font-weight: bold;
        letter-spacing: 0.5px;
        transition: 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #26c6da, #42a5f5);
            box-shadow: 0 0 15px rgba(0, 188, 212, 0.4);
        }

    .alert {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ff5252;
        font-size: 0.9rem;
    }

    .text-muted {
        color: #90a4ae !important;
    }
</style>

<div class="admin-login-card">
    <div class="text-center mb-4">
        <h2>Acceso de Administrador</h2>
        <p class="text-muted">Zona restringida</p>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
    {
        <div class="alert alert-success" role="alert">
            @ViewBag.Mensaje
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Login" method="post">
        <div class="mb-3">
            <label for="Correo">Correo Electrónico</label>
            <input type="email" class="form-control" id="Correo" name="correoElectronico"
                   placeholder="admin@medcitas.com" required>
        </div>

        <div class="mb-3">
            <label for="Contraseña">Contraseña</label>
            <input type="password" class="form-control" id="Contrasena" name="password"
                   placeholder="••••••••" required>
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg mt-3">
                Entrar
            </button>
        </div>
    </form>
</div>
