@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<link rel="stylesheet" href="~/css/password-forms.css" />

<div class="password-form-container">
  <div class="password-card">
        <!-- Header -->
        <div class="password-header">
     <div class="icon-container">
     <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
      <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
<path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
    </svg>
    </div>
      <h2>Crear Nueva Contraseña</h2>
          <p class="subtitle">Elige una contraseña segura para tu cuenta</p>
    </div>

<!-- Formulario -->
    <form asp-action="RestablecerPassword" asp-controller="Paciente" method="post" class="password-form">
        <input type="hidden" name="token" value="@ViewBag.Token" />

 @if (!string.IsNullOrEmpty(ViewBag.Error))
     {
      <div class="alert alert-danger" role="alert">
       <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
        <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
     </svg>
        @ViewBag.Error
           </div>
 }

   <div class="password-requirements">
                <h4>Tu contraseña debe contener:</h4>
      <ul>
<li id="req-length">
    <span class="check-icon">○</span> Mínimo 8 caracteres
  </li>
     <li id="req-uppercase">
    <span class="check-icon">○</span> Al menos una letra mayúscula
       </li>
  <li id="req-lowercase">
          <span class="check-icon">○</span> Al menos una letra minúscula
    </li>
      <li id="req-number">
        <span class="check-icon">○</span> Al menos un número
   </li>
       <li id="req-special">
           <span class="check-icon">○</span> Al menos un carácter especial
      </li>
   </ul>
      </div>

         <div class="form-group">
      <label for="nuevaPassword" class="form-label">
       <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
   <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
     </svg>
      Nueva Contraseña
          </label>
  <div class="password-input-wrapper">
         <input type="password" 
      class="form-control" 
            id="nuevaPassword" 
         name="nuevaPassword" 
          required
      autocomplete="new-password">
       <button type="button" class="toggle-password" data-target="nuevaPassword">
  <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
     <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
     <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
       </svg>
       </button>
   </div>
     <div class="password-strength">
  <div class="strength-bar">
        <div class="strength-fill" id="strengthFill"></div>
      </div>
        <span class="strength-text" id="strengthText">Ingresa tu contraseña</span>
</div>
    </div>

   <div class="form-group">
     <label for="confirmarPassword" class="form-label">
     <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
         <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
   </svg>
       Confirmar Contraseña
     </label>
        <div class="password-input-wrapper">
      <input type="password" 
     class="form-control" 
      id="confirmarPassword" 
 name="confirmarPassword" 
    required
         autocomplete="new-password">
      <button type="button" class="toggle-password" data-target="confirmarPassword">
<svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
      <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
      </svg>
       </button>
          </div>
      <span class="match-indicator" id="matchIndicator"></span>
          </div>

   <button type="submit" class="btn-submit">
       <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
         </svg>
         Restablecer Contraseña
       </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const nuevaPassword = document.getElementById('nuevaPassword');
        const confirmarPassword = document.getElementById('confirmarPassword');
        const strengthFill = document.getElementById('strengthFill');
     const strengthText = document.getElementById('strengthText');
        const matchIndicator = document.getElementById('matchIndicator');
        
   const requirements = {
     length: /^.{8,}$/,
     uppercase: /[A-Z]/,
         lowercase: /[a-z]/,
            number: /\d/,
          special: /[^A-Za-z\d]/
        };

    // Toggle password visibility
        document.querySelectorAll('.toggle-password').forEach(button => {
   button.addEventListener('click', function() {
   const targetId = this.getAttribute('data-target');
    const input = document.getElementById(targetId);
   input.type = input.type === 'password' ? 'text' : 'password';
});
        });

        // Validate password strength
        nuevaPassword.addEventListener('input', function() {
    const password = this.value;
            let validCount = 0;

            // Check each requirement
            for (const [key, regex] of Object.entries(requirements)) {
                const li = document.getElementById('req-' + key);
 if (regex.test(password)) {
        li.classList.add('valid');
         validCount++;
              } else {
             li.classList.remove('valid');
                }
  }

            // Update strength bar
       const strength = (validCount / 5) * 100;
    strengthFill.style.width = strength + '%';

         if (strength === 0) {
      strengthFill.style.background = '#e0e0e0';
       strengthText.textContent = 'Ingresa tu contraseña';
    strengthText.style.color = '#6c757d';
    } else if (strength <= 40) {
     strengthFill.style.background = '#dc3545';
        strengthText.textContent = 'Débil';
      strengthText.style.color = '#dc3545';
     } else if (strength <= 80) {
      strengthFill.style.background = '#ffc107';
      strengthText.textContent = 'Media';
   strengthText.style.color = '#ffc107';
            } else {
                strengthFill.style.background = '#28a745';
      strengthText.textContent = 'Fuerte';
          strengthText.style.color = '#28a745';
            }

     checkPasswordMatch();
        });

        // Check password match
        confirmarPassword.addEventListener('input', checkPasswordMatch);

  function checkPasswordMatch() {
     if (confirmarPassword.value === '') {
           matchIndicator.textContent = '';
      matchIndicator.className = 'match-indicator';
    } else if (nuevaPassword.value === confirmarPassword.value) {
            matchIndicator.textContent = 'Las contraseñas coinciden';
   matchIndicator.className = 'match-indicator match';
      } else {
         matchIndicator.textContent = 'Las contraseñas no coinciden';
       matchIndicator.className = 'match-indicator no-match';
       }
        }
    });
</script>
