@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<link rel="stylesheet" href="~/css/password-forms.css" />

<div class="password-form-container">
    <div class="password-card">
        <!-- Header con icono -->
        <div class="password-header">
            <div class="icon-container">
    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
         <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                </svg>
          </div>
     <h2>¿Olvidaste tu contraseña?</h2>
          <p class="subtitle">No te preocupes, te ayudaremos a recuperarla</p>
        </div>

      <!-- Formulario -->
        <form asp-action="RecuperarPassword" asp-controller="Paciente" method="post" class="password-form">
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
       {
                <div class="alert alert-danger" role="alert">
         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                 <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
              </svg>
           @ViewBag.ErrorMessage
    </div>
            }

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
            {
    <div class="alert alert-success" role="alert">
       <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
       <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
     </svg>
   @ViewBag.SuccessMessage
        </div>
      }

  <div class="instruction-text">
    <p>Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>
            </div>

   <div class="form-group">
    <label for="correoElectronico" class="form-label">
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
         <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
     </svg>
          Correo Electrónico
     </label>
            <input type="email" 
    class="form-control" 
         id="correoElectronico" 
   name="correoElectronico" 
     placeholder="ejemplo@correo.com"
           required 
        autocomplete="email">
          <span class="form-text">Te enviaremos un enlace válido por 15 minutos</span>
            </div>

<button type="submit" class="btn-submit">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
         <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
         </svg>
       Enviar Enlace de Recuperación
            </button>

<div class="password-links">
    <a asp-action="Login" asp-controller="Paciente" class="back-link">
           <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
     <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
    </svg>
   Volver al inicio de sesión
                </a>
    <span class="divider">|</span>
   <a asp-action="Registro" asp-controller="Paciente" class="register-link">
            ¿No tienes cuenta? <strong>Regístrate</strong>
 </a>
  </div>
        </form>

        <!-- Footer informativo -->
        <div class="password-footer">
            <div class="info-box">
           <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
     <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
     </svg>
         <div>
      <strong>Consejo de seguridad:</strong>
         <p>Si no solicitaste restablecer tu contraseña, por favor ignora este mensaje y tu contraseña permanecerá sin cambios.</p>
         </div>
            </div>
    </div>
    </div>
</div>
