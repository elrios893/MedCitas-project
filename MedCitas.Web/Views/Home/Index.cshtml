@{
    ViewData["Title"] = "Inicio - MedCitas";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">
                    Gestión de Citas Médicas
                    <span class="text-primary">¡Al Alcance De Tu Mano!</span>
                </h1>
                <p class="lead mb-4">
                    Sistema integral para la administración de tus citas médicas.
                    Agenda, gestiona y controla tus citas medicas. En nuestro sistema puedes acceder
                    a una variedad de especialidades medicas y profesionales de la salud.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Paciente" asp-action="Registro" class="btn btn-primary btn-lg">
                        <i class="bi bi-person-plus"></i> Registrarse
                    </a>
                    <a asp-controller="Paciente" asp-action="Login" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <img src="~/img/citas-image.jpg" alt="Sistema de citas médicas" class="img-fluid rounded shadow" />
            </div>
        </div>
    </div>
</section>

<!-- Mensaje para los medicos -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 d-none d-lg-block">
                <img src="~/img/doctor-image.jpg" alt="Sistema de citas médicas para medicos" class="img-fluid rounded shadow" />
            </div>
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold mb-4">
                    ¿Eres un Profesional de la Salud?
                    <span class="text-primary">¡Únete a Nuestra Plataforma!</span>
                </h1>
                <p class="lead mb-4">
                    MedCitas no solo es para pacientes. Si eres un médico o especialista,
                    puedes registrarte en nuestra plataforma para gestionar tus citas
                    y conectar con más pacientes.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Contact" asp-action="Contacto" class="btn btn-primary btn-lg">
                        <i class="bi bi-person-plus"></i> ¡Contactanos para registrarte!
                    </a>
                    <a asp-controller="Medico" asp-action="Login" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Características Principales -->
<section class="features-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Nuestros Servicios</h2>
            <p class="lead text-muted">Todo lo que necesitas para gestionar tus citas médicas</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary text-white rounded-circle mb-3">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <h3 class="h5 fw-bold">Agendar Citas</h3>
                        <p class="text-muted">
                            Programa tus consultas médicas de forma rápida y sencilla.
                            Elige fecha, hora y especialista.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary text-white rounded-circle mb-3">
                            <i class="bi bi-journal-medical"></i>
                        </div>
                        <h3 class="h5 fw-bold">Base de datos de especialistas</h3>
                        <p class="text-muted">
                            Agenda citas con los mejores especialistas para cada area de la medicina.
                            Solo aquí, en MedCitas.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-success text-white rounded-circle mb-3">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h3 class="h5 fw-bold">Registro Seguro</h3>
                        <p class="text-muted">
                            Sistema de autenticación con verificación OTP.
                            Tus datos protegidos con encriptación BCrypt.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-info text-white rounded-circle mb-3">
                            <i class="bi bi-file-medical"></i>
                        </div>
                        <h3 class="h5 fw-bold">Historial Médico</h3>
                        <p>(proximamente)</p>
                        <p class="text-muted">
                            Accede a tu historial de consultas y citas anteriores
                            desde nuestro sistema.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-info text-white rounded-circle mb-3">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>
                        <h3 class="h5 fw-bold">Base de datos de pacientes</h3
                        <p class="text-muted">
                            Como médico accede a la base de datos de tus pacientes.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-warning text-white rounded-circle mb-3">
                            <i class="bi bi-calendar3-week"></i>
                        </div>
                        <h3 class="h5 fw-bold">¡Gestiona tu tiempo!</h3
                        <p class="text-muted">
                            Como médico dale gestión a tu tiempo como desees, cancela citas, re-agenda...
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Cómo Funciona -->
<section class="how-it-works py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">¿Que debes hacer para empezar?</h2>
            <p class="lead text-muted">Solo 3 pasos para comenzar</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center">
                    <div class="step-number mb-3">1</div>
                    <h4 class="fw-bold">Regístrate</h4>
                    <p class="text-muted">
                        Crea tu cuenta de paciente con tus datos personales.
                        Recibirás un código de verificación por email.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="text-center">
                    <div class="step-number mb-3">2</div>
                    <h4 class="fw-bold">Verifica tu Cuenta</h4>
                    <p class="text-muted">
                        Ingresa el código OTP que enviamos a tu correo
                        para activar tu cuenta de forma segura.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="text-center">
                    <div class="step-number mb-3">3</div>
                    <h4 class="fw-bold">Agenda tus Citas</h4>
                    <p class="text-muted">
                        Inicia sesión y comienza a gestionar tus citas médicas
                        de manera eficiente.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section py-5">
    <div class="container text-center">
        <h2 class="display-5 fw-bold mb-4">¿Listo para Comenzar?</h2>
        <p class="lead mb-4">
            Únete a MedCitas y comienza a gestionar tus citas médicas de forma profesional
        </p>
        <a asp-controller="Paciente" asp-action="Registro" class="btn btn-primary btn-lg px-5">
            Crear Cuenta Ahora
        </a>
    </div>
</section>

@section Styles {
    <style>
        .hero-section {
            padding: 80px 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .feature-icon {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            font-size: 2rem;
        }

        .hover-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .hover-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
            }

        .step-number {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
        }

        .stat-item h3 {
            margin-bottom: 0.5rem;
        }

        .cta-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

            .cta-section .btn-primary {
                background: white;
                color: #667eea;
                border: none;
            }

                .cta-section .btn-primary:hover {
                    background: #f8f9fa;
                    transform: scale(1.05);
                }

        /* ✅ Estilos para las imágenes */
        .img-fluid {
            border-radius: 15px;
        }
    </style>
}