@model MedCitas.Core.DTOs.CitaDto

@{
    ViewData["Title"] = "Detalle de Cita";
}

<div class="container mt-5">
    <div class="row justify-content-center">
   <div class="col-md-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
       <h2>
         <i class="fas fa-file-medical-alt"></i> Detalle de Cita
</h2>
      <a asp-action="MisCitas" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Volver
   </a>
   </div>

            @if (TempData["MensajeExito"] != null)
      {
     <div class="alert alert-success alert-dismissible fade show" role="alert">
       <i class="fas fa-check-circle"></i> @TempData["MensajeExito"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
 }

  @if (TempData["Error"] != null)
  {
     <div class="alert alert-danger alert-dismissible fade show" role="alert">
 <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
         <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
       }

  @{
 var estadoClass = Model.Estado switch
  {
        "Agendada" => "primary",
"Cancelada" => "danger",
        "Completada" => "success",
       "NoAsistio" => "warning",
    _ => "secondary"
  };
       }

 <div class="card shadow-lg">
       <div class="card-header bg-@estadoClass text-white">
     <div class="d-flex justify-content-between align-items-center">
     <h4 class="mb-0">@Model.Especialidad</h4>
      <span class="badge bg-light text-dark fs-6">@Model.Estado</span>
    </div>
       </div>

           <div class="card-body">
      <!-- Información del Médico -->
          <div class="row mb-4">
     <div class="col-12">
      <h5 class="text-primary">
       <i class="fas fa-user-md"></i> Información del Médico
    </h5>
      <hr />
          </div>
     <div class="col-md-6">
     <p class="mb-2">
   <strong>Médico:</strong><br />
    <span class="fs-5">@Model.Medico</span>
   </p>
       </div>
        <div class="col-md-6">
           <p class="mb-2">
       <strong>Especialidad:</strong><br />
 <span class="fs-5">@Model.Especialidad</span>
   </p>
     </div>
       </div>

    <!-- Información de la Cita -->
       <div class="row mb-4">
     <div class="col-12">
    <h5 class="text-primary">
     <i class="fas fa-calendar-check"></i> Información de la Cita
   </h5>
    <hr />
    </div>
       <div class="col-md-6 mb-3">
          <div class="card bg-light">
       <div class="card-body">
        <p class="mb-1 text-muted">Fecha</p>
    <p class="fs-5 mb-0">
       <i class="fas fa-calendar"></i> 
    @Model.FechaCita.ToString("dddd, dd MMMM yyyy")
 </p>
        </div>
     </div>
     </div>
    <div class="col-md-6 mb-3">
          <div class="card bg-light">
       <div class="card-body">
     <p class="mb-1 text-muted">Hora</p>
       <p class="fs-5 mb-0">
   <i class="fas fa-clock"></i> 
  @Model.HoraInicio.ToString(@"hh\:mm") - @Model.HoraFin.ToString(@"hh\:mm")
    </p>
   </div>
  </div>
 </div>
    <div class="col-md-6 mb-3">
       <div class="card bg-light">
       <div class="card-body">
       <p class="mb-1 text-muted">Modalidad</p>
      <p class="fs-5 mb-0">
       @if (Model.Modalidad == "Virtual")
     {
  <i class="fas fa-video text-primary"></i>
        }
     else
       {
      <i class="fas fa-hospital text-primary"></i>
 }
        @Model.Modalidad
        </p>
    </div>
  </div>
    </div>
  <div class="col-md-6 mb-3">
  <div class="card bg-light">
      <div class="card-body">
  <p class="mb-1 text-muted">Estado</p>
       <p class="fs-5 mb-0">
     <span class="badge bg-@estadoClass">@Model.Estado</span>
         </p>
      </div>
   </div>
  </div>
           </div>

    @if (!string.IsNullOrEmpty(Model.MotivoConsulta))
       {
  <div class="row mb-4">
        <div class="col-12">
       <h5 class="text-primary">
         <i class="fas fa-notes-medical"></i> Motivo de Consulta
   </h5>
      <hr />
<div class="card bg-light">
       <div class="card-body">
      @Model.MotivoConsulta
 </div>
   </div>
       </div>
   </div>
        }

     @if (!string.IsNullOrEmpty(Model.Observaciones))
 {
    <div class="row mb-4">
   <div class="col-12">
 <h5 class="text-primary">
       <i class="fas fa-clipboard"></i> Observaciones
    </h5>
<hr />
   <div class="card bg-light">
    <div class="card-body">
   @Model.Observaciones
       </div>
 </div>
       </div>
      </div>
       }

   @if (Model.Estado == "Agendada")
      {
   <div class="row">
    <div class="col-12">
        <h5 class="text-primary">
 <i class="fas fa-cog"></i> Acciones
       </h5>
       <hr />

       @if (Model.PuedeCancelarse)
     {
         <div class="alert alert-info">
       <i class="fas fa-info-circle"></i> 
   Faltan <strong>@Math.Round(Model.HorasHastaCita, 1) horas</strong> para tu cita.
  Puedes cancelarla si lo necesitas.
 </div>

  <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar">
        <i class="fas fa-times-circle"></i> Cancelar Cita
   </button>
    }
      else
   {
     <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> 
    <strong>No se puede cancelar</strong><br />
    La cita está próxima (menos de 24 horas). Para cancelar, contacta directamente con el consultorio.
       </div>
        }
 </div>
      </div>
        }
 </div>
 </div>
   </div>
    </div>
</div>

<!-- Modal de Confirmación de Cancelación -->
<div class="modal fade" id="modalCancelar" tabindex="-1">
    <div class="modal-dialog">
   <div class="modal-content">
      <div class="modal-header bg-danger text-white">
   <h5 class="modal-title">
    <i class="fas fa-exclamation-triangle"></i> Confirmar Cancelación
     </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
   </div>
       <form asp-action="Cancelar" method="post">
 @Html.AntiForgeryToken()
   <input type="hidden" name="id" value="@Model.Id" />
      
    <div class="modal-body">
          <p class="mb-3">¿Estás seguro que deseas cancelar esta cita?</p>
  
     <div class="card bg-light mb-3">
    <div class="card-body">
      <p class="mb-1"><strong>Médico:</strong> @Model.Medico</p>
     <p class="mb-1"><strong>Fecha:</strong> @Model.FechaCita.ToString("dd/MM/yyyy")</p>
    <p class="mb-0"><strong>Hora:</strong> @Model.HoraInicio.ToString(@"hh\:mm")</p>
        </div>
   </div>

      <div class="mb-3">
 <label for="motivoCancelacion" class="form-label">Motivo de Cancelación (Opcional)</label>
      <textarea name="motivoCancelacion" id="motivoCancelacion" class="form-control" 
   rows="3" maxlength="200" placeholder="Ej: Cambio de planes, emergencia personal..."></textarea>
     </div>

        <div class="alert alert-warning mb-0">
        <i class="fas fa-info-circle"></i> 
       Esta acción no se puede deshacer. Recibirás un correo de confirmación.
   </div>
   </div>
  
       <div class="modal-footer">
  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
       <i class="fas fa-times"></i> No, Mantener Cita
     </button>
       <button type="submit" class="btn btn-danger">
       <i class="fas fa-check"></i> Sí, Cancelar Cita
       </button>
   </div>
      </form>
</div>
    </div>
</div>

@section Scripts {
    <script>
      // Auto-cerrar alertas después de 5 segundos
   setTimeout(function() {
      var alerts = document.querySelectorAll('.alert-dismissible');
  alerts.forEach(function(alert) {
var bsAlert = new bootstrap.Alert(alert);
  bsAlert.close();
 });
 }, 5000);
    </script>
}
